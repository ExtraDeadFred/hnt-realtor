# OPTIONAL fallback — daily-brief.ps1 reads these names from Windows
# environment variables first (set via [System.Environment]::SetEnvironmentVariable
# with the 'User' scope). Only fill this file in if you don't want env vars.
# Copy to local\.env; it is gitignored — NEVER commit it.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=extradeadfred@gmail.com
# Gmail "App Password" (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=extradeadfred@gmail.com

# Comma-separated recipients. Defaults to SMTP_FROM_EMAIL if unset —
# start with just yourself to test, then add forsalebyhunt@gmail.com.
MAIL_TO=extradeadfred@gmail.com, forsalebyhunt@gmail.com
