# Copy to local\.env and fill in. local\.env is gitignored — NEVER commit it.

# The Gmail account that SENDS the brief (Freddie's).
GMAIL_USER=extradeadfred@gmail.com

# An "App Password" for that account (not the normal password):
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Comma-separated recipients. Start with just yourself to test.
MAIL_TO=extradeadfred@gmail.com, forsalebyhunt@gmail.com
